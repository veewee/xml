            throw \PHPUnit\Framework\InvalidArgumentException::create(1, 'integer or string');
        }
        if (!(is_array($array) || $array instanceof ArrayAccess)) {
            throw \PHPUnit\Framework\InvalidArgumentException::create(2, 'array or ArrayAccess');
