        $this->methodName = $methodName;
        $this->cloneArguments = $cloneArguments;
        $this->modifier = $modifier;
        $this->argumentsForDeclaration = $argumentsForDeclaration;
        $this->argumentsForCall = $argumentsForCall;
        $this->returnType = $returnType;
