declare (strict_types=1);
namespace PHPUnitPHAR\PHPStan\PhpDocParser\Ast\NodeVisitor;

use PHPUnitPHAR\PHPStan\PhpDocParser\Ast\AbstractNodeVisitor;
use PHPUnitPHAR\PHPStan\PhpDocParser\Ast\Attribute;
use PHPUnitPHAR\PHPStan\PhpDocParser\Ast\Node;
final class CloningVisitor extends AbstractNodeVisitor
{
    public function enterNode(Node $originalNode)
    {
        $node = clone $originalNode;
        $node->setAttribute(Attribute::ORIGINAL_NODE, $originalNode);
        return $node;
    }
}
