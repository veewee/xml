    {
        $totalsContainer = $this->contextNode()->firstChild;
        if (!$totalsContainer) {
            $totalsContainer = $this->contextNode()->appendChild($this->dom->createElementNS('https://schema.phpunit.de/coverage/1.0', 'totals'));
        }
        return new Totals($totalsContainer);
