                    <xs:group ref="pathGroup"/>
                </xs:complexType>
            </xs:element>
            <xs:element name="exclude" minOccurs="0" maxOccurs="1">
                <xs:complexType>
                    <xs:group ref="pathGroup"/>
                </xs:complexType>
            </xs:element>
