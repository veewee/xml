declare (strict_types=1);
namespace PHPUnitPHAR\PhpParser\Node\Expr;

use PHPUnitPHAR\PhpParser\Node\Expr;
class ArrayItem extends Expr
{
    /** @var null|Expr Key */
    public $key;
    /** @var Expr Value */
